{
  "name": "agent-platform-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dsh": {
    "frontend": {
      "name": "web",
      "install": "npm ci --no-audit --no-fund",
      "dev": "npm run dev -- --host 127.0.0.1 --port {port}",
      "build": "npm run build",
      "start": "npm run preview -- --host 127.0.0.1 --port {port}",
      "dist": "dist",
      "requiresNode": true
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5",
    "@tanstack/react-virtual": "^3.14.17",
    "@xyflow/react": "^12.11.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
