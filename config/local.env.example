# ─────────────────────────────────────────────────────────────
# 本地运行配置（python minidsh.py ...）
#
# 复制为 config/local.env 后使用；`python minidsh.py setup` 会自动创建。
# 进程环境变量优先于本文件。真实密钥不要提交到 Git。
# ─────────────────────────────────────────────────────────────

# ── 数据库（必填）──
# 需要 PostgreSQL + pgvector + pg_trgm。
DATABASE_URL=postgresql://saas:saas@127.0.0.1:5432/saas
# Redis 可选：不可用时只影响语义缓存，主对话仍可运行。
REDIS_URL=redis://localhost:6379/0

# ── 模型 / RAG ──
OLLAMA_HOST=http://localhost:11434
# 论文总结用 LLM（OpenAI 兼容网关）
# PAPER_LLM_BASE_URL=
# PAPER_LLM_API_KEY=
# PAPER_LLM_MODEL=

# ── 本地数据目录 ──
# 统一存放 workspaces、skills、paper cache；默认 ~/.minidsh
# MINIDSH_HOME=D:/minidsh-data

# ── 内置 MCP 端口 ──
# 避开 Windows 常见的 9000 保留端口段。
BUILTIN_MCP_PORT=19001
PAPER_MCP_PORT=19002

# ── 沙箱 ──
SANDBOX_BACKEND=local
# read-only / workspace-write / danger-full-access
SANDBOX_DEFAULT_MODE=workspace-write
# SANDBOX_WORKSPACE_ROOT=...
# SANDBOX_READ_ROOTS=D:/jk/Papers,D:/jk/Documents
# SANDBOX_WRITE_ROOTS=D:/jk/Nexus
# SANDBOX_IMAGE=agent-sandbox:1

# ── 插件 ──
# 默认自动发现 config/plugins.yaml；只有放到其他路径时才需要设置。
# PLUGIN_CONFIG=config/plugins.yaml
# PLUGIN_MCP_AUTO=true

# ── Overleaf（可选）──
OVERLEAF_ENABLED=false
OVERLEAF_RT_ENABLED=false
# 独立 SDK 2 解释器（overleaf-mcp-plus 需要单独环境）
# OVERLEAF_MCP_PYTHON=D:/path/to/overleaf-venv/Scripts/python.exe
# Overleaf 账户凭据：本地运行时直接写在这里（文件已被 gitignore）
# OVERLEAF_SESSION=
# OVERLEAF_GIT_TOKEN=
# OVERLEAF_BASE_URL=https://www.overleaf.com
# OVERLEAF_GIT_HOST=git.overleaf.com
# OVERLEAF_RT_URL=https://www.overleaf.com
# OVERLEAF_RT_SESSION_COOKIE=
# OVERLEAF_RT_CREDENTIALS_FILE=~/.cache/overleaf-mcp/rt-credentials.json

# ── 前端 / 后端地址（通常由 CLI 端口参数生成）──
# NEXT_PUBLIC_API_URL=http://localhost:8000
# BACKEND_URL=http://127.0.0.1:8000
# CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# ── 安全 ──
# setup 会用随机值替换此占位符。
JWT_SECRET=GENERATE_ON_SETUP
