# ─────────────────────────────────────────────────────────────
# Docker Compose 配置
#
# 复制为 config/docker.env 后使用：
#   docker compose --env-file config/docker.env up -d --build
#   python minidsh.py docker        # 等价，自动带 --env-file
#
# 这里只放 Compose 变量替换使用的值。容器内的 DATABASE_URL、JWT_SECRET
# 由 docker-compose.yml 固定注入，不从本文件读取。
# 真实密钥不要提交到 Git。
# ─────────────────────────────────────────────────────────────

# ── 构建 ──
# PRELOAD_RERANKER=false

# ── 插件 ──
# Compose 默认传递 /app/config/cordis.yml 和 /app/config/cordis.patch.yml。
# 仅在使用其他容器内根配置路径时设置。
# PLUGIN_CONFIG=
# PLUGIN_MCP_AUTO=true
# SKILL_SOURCES=[]

# ── 沙箱 ──
# SANDBOX_BACKEND=docker
# SANDBOX_IMAGE=agent-sandbox:1
# 附加只读/可写宿主目录（逗号分隔，Docker daemon 解析的宿主路径）
# SANDBOX_READ_ROOTS=D:/jk/Papers,D:/jk/Documents
# SANDBOX_WRITE_ROOTS=D:/jk/Nexus

# ── 论文总结 LLM（OpenAI 兼容网关）──
# PAPER_LLM_BASE_URL=
# PAPER_LLM_API_KEY=
# PAPER_LLM_MODEL=

# ── Overleaf（可选）──
# OVERLEAF_SESSION=
# OVERLEAF_GIT_TOKEN=
# OVERLEAF_BASE_URL=https://www.overleaf.com
# OVERLEAF_GIT_HOST=git.overleaf.com

# ── Overleaf 实时服务（可选）──
# OVERLEAF_RT_ENABLED=true
# OVERLEAF_RT_URL=https://www.overleaf.com
# OVERLEAF_RT_SESSION_COOKIE=
