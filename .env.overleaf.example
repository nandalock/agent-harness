# Copy these entries into .env. Both Codex and the project use this local file.
# DevTools > Application > Cookies > https://www.overleaf.com > overleaf_session2
OVERLEAF_SESSION=
# Optional: Overleaf account settings > Git Integration > Create Token
OVERLEAF_GIT_TOKEN=
# Defaults below also support self-hosted Overleaf.
OVERLEAF_BASE_URL=https://www.overleaf.com
OVERLEAF_GIT_HOST=git.overleaf.com
