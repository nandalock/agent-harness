# Used only by `python minidsh.py ...`; does not load Docker's .env.
# Native PostgreSQL must have pgvector and pg_trgm installed.
DATABASE_URL=postgresql://saas:saas@localhost:5432/saas
REDIS_URL=redis://localhost:6379/0
OLLAMA_HOST=http://localhost:11434
# setup replaces this placeholder with a random local secret.
JWT_SECRET=GENERATE_ON_SETUP
# Optional: relocate all local workspaces, skills and caches together.
# MINIDSH_HOME=D:/minidsh-data
# Native MCP ports avoid the Windows reserved 9000 port range.
BUILTIN_MCP_PORT=19001
PAPER_MCP_PORT=19002
OVERLEAF_ENABLED=false
OVERLEAF_RT_ENABLED=false
# Optional isolated SDK 2 interpreter for Overleaf:
# OVERLEAF_MCP_PYTHON=D:/path/to/overleaf-venv/Scripts/python.exe
# PAPER_LLM_BASE_URL=
# PAPER_LLM_API_KEY=
# PAPER_LLM_MODEL=
